# Sanity Configuration
# Copy this file to .env.local and fill in your values

# Get these from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=9qnllyyc
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: For write operations (content updates from Next.js)
SANITY_API_TOKEN=your_sanity_api_token

# Sanity Studio URL (after deployment)
NEXT_PUBLIC_SANITY_STUDIO_URL=https://your-project.sanity.studio
